# 运行产物与本地环境（不进版本库）
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# 运行日志与输出
logs/
out/

# 音色页的运行期数据（本账号自定义音色的显示名登记表、试听缓存）
# —— 因账号/机器而异，不入库（丢了按 id 显示，不影响音色本身）
voices/
previews/

# 覆盖率数据（coverage.py；scripts/run_tests.py --coverage 与 CI 会生成，不入库）
.coverage
.coverage.*
htmlcov/

# PyInstaller 打包产物（dist/ 是要发给别人的 exe；build/ 与 .spec 是中间产物）
dist/
build/
*.spec

# 用户自己的配置（设备名、语言偏好等因机器而异，不入库）
# 入库的是 config.example.yaml 模板；首次运行会自动复制生成 config.yaml
config.yaml
# 配置写坏时的自动备份（见 vlt/config.py 的恢复逻辑）
config.yaml.broken
config.local.yaml

# 编辑器
.vscode/
.idea/
*.swp

# 打包产物：仓库根目录直接 build 出来的 exe 不入库（要发的是 Release 附件）
/*.exe
